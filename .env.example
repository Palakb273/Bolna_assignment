# Documentation only. Never overwrite an existing .env.
# Backend reads process environment. Generate isolated local credentials with scripts/init_local_config.py.
BOLNA_API_KEY=your_bolna_api_key
BOLNA_AGENT_ID=your_agent_id
DATABASE_URL=postgresql+psycopg://bolna_app:REPLACE_PASSWORD@127.0.0.1:55432/bolna
BOLNA_SERVICE_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_ADMIN_SECRET
BOLNA_WEBHOOK_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_WEBHOOK_SECRET
EVIDENCE_ADAPTER_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_ADAPTER_SECRET
POSTAL_DATA_PATH=local-data/postal/release.json
POSTAL_SOURCE_KIND=OFFICIAL_POSTAL_DIRECTORY
MAX_POSTAL_SOURCE_AGE_DAYS=90
APP_ENV=production
ALLOW_UNVERIFIED_POSTAL_DATA=false
# Demo only, explicitly approved malformed-row exclusion; default stays strict.
DEMO_REJECT_MALFORMED_ROWS=false
